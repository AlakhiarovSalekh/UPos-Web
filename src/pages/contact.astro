---
import BaseLayout from '../layouts/BaseLayout.astro';
import { company } from '../data/site';
---
<BaseLayout title="Contact — UPos" description="Talk to the UPos team about product questions, sales, onboarding or support.">
  <section class="legal-hero"><div class="shell"><p class="kicker"><span></span> Contact</p><h1>We’re here to<br/><em>help you move.</em></h1><p>Questions about UPos, onboarding or your account? Reach the right team below.</p></div></section>
  <section class="section contact-page"><div class="shell contact-grid"><div class="contact-cards"><article><span>Sales & onboarding</span><h2>Find the right setup</h2><p>Tell us how your stores work and what you want to improve.</p><a href={`mailto:${company.email}?subject=UPos sales enquiry`}>{company.email} →</a></article><article><span>Customer support</span><h2>Get help with UPos</h2><p>Include your account email and a clear description so we can help faster.</p><a href={`mailto:${company.email}?subject=UPos support request`}>{company.email} →</a></article></div><aside class="contact-detail"><h2>Contact details</h2><dl><dt>Email</dt><dd><a href={`mailto:${company.email}`}>{company.email}</a></dd><dt>Support hours</dt><dd>{company.supportHours}</dd><dt>Response time</dt><dd>Typically {company.responseTime}</dd></dl></aside></div></section>
</BaseLayout>
