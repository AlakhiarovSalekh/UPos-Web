---
import { plans } from '../data/site';
---
<div class="billing-toggle" role="group" aria-label="Billing period">
  <button class="is-active" data-billing="monthly">Monthly</button>
  <button data-billing="annual">Annual <span>2 months free</span></button>
</div>
<div class="pricing-grid">
  {plans.map((plan) => (
    <article class:list={['price-card', { featured: plan.featured }]}>
      {plan.featured && <span class="popular">Most popular</span>}
      <div><p class="eyebrow">{plan.name}</p><h3>{plan.description}</h3></div>
      <div class="price"><span>$</span><strong data-monthly={plan.monthly} data-annual={Math.round(plan.annual / 12)}>{plan.monthly}</strong><span>/mo</span></div>
      <p class="billing-note" data-note>charged monthly</p>
      <a class:list={['button', { 'button-dark': !plan.featured }]} href={`/checkout/?plan=${plan.name.toLowerCase()}`}>Start 14-day free trial</a>
      <p class="no-card">No card required for trial</p>
      <ul>
        <li>{plan.locations}</li><li>{plan.users}</li>
        {plan.features.map((feature) => <li>{feature}</li>)}
      </ul>
    </article>
  ))}
</div>
<script>
  const billingButtons = document.querySelectorAll('[data-billing]');
  billingButtons.forEach((button) => button.addEventListener('click', () => {
    const annual = button.getAttribute('data-billing') === 'annual';
    billingButtons.forEach((item) => item.classList.toggle('is-active', item === button));
    document.querySelectorAll('[data-monthly]').forEach((price) => {
      price.textContent = annual ? price.getAttribute('data-annual') : price.getAttribute('data-monthly');
    });
    document.querySelectorAll('[data-note]').forEach((note) => {
      note.textContent = annual ? 'charged annually' : 'charged monthly';
    });
  }));
</script>
